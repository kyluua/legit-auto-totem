{
	"schemaVersion": 1,
	"id": "utilitiesscarce",
	"version": "${version}",
	"name": "Utilities Scarce",
	"description": "Client-side utility modules: Auto Totem, Stun Slam, Shield Disable, Breach Swap, Fast Anchor and Free Cam. Every module is configurable and hotkey-toggleable.",
	"authors": [
		"kyluua"
	],
	"contact": {
		"sources": "https://github.com/kyluua/legit-auto-totem",
		"issues": "https://github.com/kyluua/legit-auto-totem/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.kyluua.utilitiesscarce.UtilitiesScarceClient"
		],
		"modmenu": [
			"dev.kyluua.utilitiesscarce.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "utilitiesscarce.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
